** sch_path: /home/harry/Git/CMOS_INA_GF180MCU/xschem/blocks/fdda_lv/tb_fdda_lv_aol.sch
**.subckt tb_fdda_lv_aol
C1 Von 0 100p m=1
x2 PSUP_LV VCM VCM INM INP Vop Von net2 0 net3 VCM fdda_lv
VDD PSUP_LV 0 {vdd}
C2 Vop 0 100p m=1
VCM VCM 0 {vdd/2}
* noconn #net3
VDM INP INM DC 0 AC 1
R1 VCM INP 1G m=1
R2 INM VCM 1G m=1
XM7 g g PSUP_LV PSUP_LV pfet_03v3 L=4u W=2u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)'
+ ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0 m=4
XM1 net1 g PSUP_LV PSUP_LV pfet_03v3 L=4u W=2u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)'
+ ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0 m=4
I1 g 0 1u
Vmeas1 net1 net2 0
.save i(vmeas1)
**** begin user architecture code

.include /usr/share/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice

.lib /usr/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /usr/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical
.lib /usr/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice bjt_typical
.lib /usr/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice mimcap_typical
.lib /usr/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice cap_mim

.temp 27

.param vcm=1.8
.param vdd=3.3

* Deterministic PVT: disable random global/mismatch variation.
.param sw_stat_global=0
.param sw_stat_mismatch=0



.control
set units=degrees
save all
ac dec 100 1 1G

let Vid = v(INP) - v(INM)
let Vo = v(Vop) - v(Von)
let aol = v(Vo) / v(Vid)
let gain_db = db(aol)
let phase_deg = cph(aol)

meas ac UGF when gain_db=0
meas ac phase_margin find phase_deg when gain_db=0
meas ac AOL find gain_db when frequency=10

*write tb_fdda_lv_aol.raw frequency v(Vop) v(Von) v(Vo) aol gain_db phase_deg
write tb_fdda_lv_aol.raw

.endc


**** end user architecture code
**.ends

