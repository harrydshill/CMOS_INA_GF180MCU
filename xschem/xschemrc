# Set default PDK_ROOT
if { ![info exists env(PDK_ROOT)] } {
	puts stderr "Warning: PDK_ROOT env. var. not found or empty, trying to find an open-pdks install"
	if {[file isdir /usr/share/pdk]} {set ::env(PDK_ROOT) /usr/share/pdk
	} elseif {[file isdir /usr/local/share/pdk]} {set ::env(PDK_ROOT) /usr/local/share/pdk
	} elseif {[file isdir $env(HOME)/share/pdk]} {set ::env(PDK_ROOT) $env(HOME)/share/pdk
	} elseif {[file isdir $env(HOME)/.ciel]} {set ::env(PDK_ROOT) $env(HOME)/.ciel
	} else {
		puts stderr {No open-pdks installation found, set PDK_ROOT env. var. and restart xschem}
	}
}

# Set default PDK
if { ![info exists env(PDK)] } {
	set ::env(PDK) gf180mcuD
}

# Source the PDK xschemrc file
if {![info exists PDK]} {
	source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
}

# This file's directory is the project Xschem root, independent of $HOME.
set PROJECT_DIR [file dirname [file normalize [info script]]]


# -----------------------------------------------------------------------------
# Project symbol / hierarchical-schematic libraries
# -----------------------------------------------------------------------------
# XSCHEM_LIBRARY_PATH is a COLON-delimited string, not a Tcl list.  Use
# 'append ... :path' rather than 'lappend'.  The text after '|' is a library
# alias: it makes a visible, stable name in the Xschem library browser and
# creates portable references such as 'ota/ota.sym'.
if {![info exists XSCHEM_LIBRARY_PATH]} {
  	set XSCHEM_LIBRARY_PATH {}
}

# Optional project-wide helpers.  References become common/<symbol>.sym.
set shared_symbols [file join $PROJECT_DIR common symbols]
if {[file isdirectory $shared_symbols]} {
#  	append XSCHEM_LIBRARY_PATH ":${shared_symbols}"
#}

# Every immediate blocks/<block-name>/ directory is an individual visible
# Xschem library.  A directory such as blocks/ota/ containing ota.sym and
# ota.sch therefore appears as library alias 'ota' in the component browser.
set blocks_dir [file join $PROJECT_DIR blocks]
if {[file isdirectory $blocks_dir]} {
	foreach block_dir [lsort [glob -nocomplain -types d [file join $blocks_dir *]]] {
		set block_name [file tail $block_dir]
		append XSCHEM_LIBRARY_PATH ":[file normalize $block_dir]"
	}
}

